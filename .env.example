# vCenter connection
VCENTER_HOST=vcenter.example.com
VCENTER_USER=administrator@vsphere.local
VCENTER_PASSWORD=changeme
VCENTER_INSECURE=true

# Database
DATABASE_HOST=localhost
DATABASE_USERNAME=vsphere_auditor
DATABASE_PASSWORD=

# Email reports
REPORT_FROM_EMAIL=vsphere-auditor@example.com
REPORT_RECIPIENTS=admin@example.com

# Authentication (leave blank to disable)
AUTH_USERNAME=
AUTH_PASSWORD=

# SMTP
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=25

# Data retention (months to keep, default 12)
RETENTION_MONTHS=12
