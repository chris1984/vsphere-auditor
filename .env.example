# vCenter connections are now managed via the web UI.
# The ENV vars below are kept for backward compatibility with
# the initial single-vCenter setup but are no longer required.
# VCENTER_HOST=vcenter.example.com
# VCENTER_USER=administrator@vsphere.local
# VCENTER_PASSWORD=changeme
# VCENTER_INSECURE=true

# Database
DATABASE_HOST=localhost
DATABASE_USERNAME=vsphere_auditor
DATABASE_PASSWORD=

# Email reports
REPORT_FROM_EMAIL=vsphere-auditor@example.com
REPORT_RECIPIENTS=admin@example.com

# Authentication (leave blank to disable)
AUTH_USERNAME=
AUTH_PASSWORD=

# SMTP
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=25

# Active Record Encryption (generate with: bin/rails db:encryption:init)
# Required for encrypting vCenter passwords at rest
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# Data retention (months to keep, default 12)
RETENTION_MONTHS=12
