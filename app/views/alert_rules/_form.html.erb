<%= form_with(model: @alert_rule, class: "alert-form") do |f| %>
  <% if @alert_rule.errors.any? %>
    <div class="card" style="border-color: var(--danger); margin-bottom: 15px;">
      <div class="card-body">
        <% @alert_rule.errors.full_messages.each do |msg| %>
          <p style="color: var(--danger); margin: 0;"><%= msg %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="card">
    <div class="card-header">Rule Configuration</div>
    <div class="card-body">
      <div class="form-grid">
        <div class="form-group">
          <%= f.label :name, "Rule Name" %>
          <%= f.text_field :name, placeholder: "e.g., Permission Changes" %>
        </div>

        <div class="form-group">
          <%= f.label :event_category, "Event Category" %>
          <%= f.select :event_category, [["Any Category", ""]] + AuditEvent::CATEGORIES.values.uniq.sort.map { |c| [c.titleize, c] }, {}, {} %>
        </div>

        <div class="form-group">
          <%= f.label :severity, "Minimum Severity" %>
          <%= f.select :severity, [["Any Severity", ""]] + AuditEvent::SEVERITIES.map { |s| [s.upcase, s] }, {}, {} %>
        </div>

        <div class="form-group">
          <%= f.label :username_match, "Username Contains" %>
          <%= f.text_field :username_match, placeholder: "Leave blank for any user" %>
        </div>

        <div class="form-group full-width">
          <%= f.label :recipients, "Email Recipients" %>
          <%= f.text_field :recipients, placeholder: "user@example.com, other@example.com" %>
          <span class="form-hint">Comma-separated email addresses</span>
        </div>

        <div class="form-group">
          <%= f.label :enabled, class: "checkbox-label" do %>
            <%= f.check_box :enabled %>
            Enabled
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div style="margin-top: 15px;">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", alert_rules_path, class: "btn btn-secondary" %>
  </div>
<% end %>
