vSphere Audit Report - <%= @date.strftime("%A, %B %d, %Y") %>
===========================================================

SUMMARY
  Total Events: <%= @summary[:total] %>
  Warnings/Errors: <%= @summary[:by_severity]["warning"].to_i + @summary[:by_severity]["error"].to_i + @summary[:by_severity]["critical"].to_i %>
  Active Users: <%= @summary[:by_user].keys.count %>

<% if @summary[:warnings].any? %>
WARNINGS & ERRORS
<% @summary[:warnings].each do |event| %>
  [<%= event.severity.upcase %>] <%= event.event_timestamp.strftime("%H:%M:%S") %> - <%= event.event_type %> - <%= event.object_name %> (<%= event.username %>)
    <%= event.message %>
<% end %>

<% end %>
ACTIVITY BY CATEGORY
<% @summary[:by_category].sort_by { |_, v| -v }.each do |category, count| %>
  <%= category.titleize.ljust(25) %> <%= count %>
<% end %>

ACTIVITY BY USER
<% @summary[:by_user].sort_by { |_, v| -v }.each do |user, count| %>
  <%= user.to_s.ljust(30) %> <%= count %>
<% end %>

ALL EVENTS
<% @events.each do |event| %>
  <%= event.event_timestamp.strftime("%H:%M:%S") %> | <%= event.event_type.ljust(30) %> | <%= event.object_name.to_s.ljust(20) %> | <%= event.username.to_s.ljust(15) %> | <%= event.message %>
<% end %>

---
Generated by vSphere Auditor - <%= Time.current.strftime("%Y-%m-%d %H:%M %Z") %>
