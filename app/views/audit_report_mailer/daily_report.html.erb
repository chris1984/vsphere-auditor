<div class="container">
  <div class="header">
    <h1>vSphere Audit Report</h1>
    <p><%= @date.strftime("%A, %B %d, %Y") %></p>
  </div>

  <div class="content">
    <div class="summary-grid">
      <div class="stat-box">
        <div class="number"><%= @summary[:total] %></div>
        <div class="label">Total Events</div>
      </div>
      <div class="stat-box">
        <div class="number"><%= @summary[:by_severity]["warning"].to_i + @summary[:by_severity]["error"].to_i + @summary[:by_severity]["critical"].to_i %></div>
        <div class="label">Warnings</div>
      </div>
      <div class="stat-box">
        <div class="number"><%= @summary[:by_user].keys.count %></div>
        <div class="label">Active Users</div>
      </div>
      <div class="stat-box">
        <div class="number"><%= @summary[:by_category].keys.count %></div>
        <div class="label">Categories</div>
      </div>
    </div>

    <% if @summary[:warnings].any? %>
      <div class="section-title">Warnings &amp; Errors</div>
      <table>
        <thead>
          <tr>
            <th>Time</th>
            <th>Severity</th>
            <th>Type</th>
            <th>Object</th>
            <th>User</th>
            <th>Message</th>
          </tr>
        </thead>
        <tbody>
          <% @summary[:warnings].each do |event| %>
            <tr>
              <td><%= event.event_timestamp.strftime("%H:%M:%S") %></td>
              <td><span class="severity-<%= event.severity %>"><%= event.severity.upcase %></span></td>
              <td><%= event.event_type %></td>
              <td><%= event.object_name %></td>
              <td><%= event.username %></td>
              <td class="msg"><%= truncate(event.message, length: 120) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <div class="section-title">Activity by Category</div>
    <table class="breakdown-table">
      <tbody>
        <% @summary[:by_category].sort_by { |_, v| -v }.each do |category, count| %>
          <tr>
            <td><%= category.titleize %></td>
            <td><%= count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="section-title">Activity by User</div>
    <table class="breakdown-table">
      <tbody>
        <% @summary[:by_user].sort_by { |_, v| -v }.each do |user, count| %>
          <tr>
            <td><%= user %></td>
            <td><%= count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="section-title">All Events</div>
    <table>
      <thead>
        <tr>
          <th>Time</th>
          <th>Type</th>
          <th>Object</th>
          <th>User</th>
          <th>Message</th>
        </tr>
      </thead>
      <tbody>
        <% @events.each do |event| %>
          <tr>
            <td><%= event.event_timestamp.strftime("%H:%M:%S") %></td>
            <td><%= event.event_type %></td>
            <td><%= event.object_name %></td>
            <td><%= event.username %></td>
            <td class="msg"><%= truncate(event.message, length: 120) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="footer">
    Generated by vSphere Auditor &bull; <%= Time.current.strftime("%Y-%m-%d %H:%M %Z") %>
  </div>
</div>
