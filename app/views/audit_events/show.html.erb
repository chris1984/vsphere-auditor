<div class="page-header">
  <h1>Event Detail</h1>
  <p><%= link_to "Back to Events", audit_events_path %></p>
</div>

<div class="card">
  <div class="card-body">
    <dl class="detail-grid">
      <dt>Event Type</dt>
      <dd><%= @event.event_type %></dd>

      <dt>Category</dt>
      <dd><%= category_label(@event.event_category) %></dd>

      <dt>Severity</dt>
      <dd><%= severity_badge(@event.severity) %></dd>

      <dt>Timestamp</dt>
      <dd><%= @event.event_timestamp&.strftime("%Y-%m-%d %H:%M:%S %Z") %></dd>

      <dt>User</dt>
      <dd><%= @event.username %></dd>

      <dt>Object Type</dt>
      <dd><%= @event.object_type %></dd>

      <dt>Object Name</dt>
      <dd><%= @event.object_name %></dd>

      <dt>Object Ref</dt>
      <dd><%= @event.object_ref || "N/A" %></dd>

      <dt>vCenter Key</dt>
      <dd><%= @event.vcenter_event_key %></dd>

      <dt>Chain ID</dt>
      <dd><%= @event.vcenter_chain_id %></dd>

      <dt>Message</dt>
      <dd><%= @event.message %></dd>

      <% if @event.old_value.present? %>
        <dt>Old Value</dt>
        <dd><pre><%= @event.old_value %></pre></dd>
      <% end %>

      <% if @event.new_value.present? %>
        <dt>New Value</dt>
        <dd><pre><%= @event.new_value %></pre></dd>
      <% end %>

      <dt>Recorded At</dt>
      <dd><%= @event.created_at&.strftime("%Y-%m-%d %H:%M:%S %Z") %></dd>
    </dl>
  </div>
</div>
