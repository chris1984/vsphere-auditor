<div class="container">
  <div class="header" style="background: #c53030;">
    <h1>vSphere Alert: <%= @rule.name %></h1>
    <p><%= @event.event_timestamp&.strftime("%Y-%m-%d %H:%M:%S %Z") %></p>
  </div>

  <div class="content">
    <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
      <tr>
        <td style="padding: 10px 12px; font-weight: 600; background: #f8f9fa; width: 150px; border-bottom: 1px solid #eee;">Event Type</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #eee;"><%= @event.event_type %></td>
      </tr>
      <tr>
        <td style="padding: 10px 12px; font-weight: 600; background: #f8f9fa; border-bottom: 1px solid #eee;">Category</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #eee;"><%= @event.event_category&.titleize %></td>
      </tr>
      <tr>
        <td style="padding: 10px 12px; font-weight: 600; background: #f8f9fa; border-bottom: 1px solid #eee;">Severity</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #eee;"><%= @event.severity&.upcase %></td>
      </tr>
      <tr>
        <td style="padding: 10px 12px; font-weight: 600; background: #f8f9fa; border-bottom: 1px solid #eee;">User</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #eee;"><%= @event.username %></td>
      </tr>
      <tr>
        <td style="padding: 10px 12px; font-weight: 600; background: #f8f9fa; border-bottom: 1px solid #eee;">Object</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #eee;"><%= @event.object_name %> (<%= @event.object_type %>)</td>
      </tr>
      <tr>
        <td style="padding: 10px 12px; font-weight: 600; background: #f8f9fa; border-bottom: 1px solid #eee;">Message</td>
        <td style="padding: 10px 12px; border-bottom: 1px solid #eee;"><%= @event.message %></td>
      </tr>
    </table>

    <p style="margin-top: 15px; font-size: 12px; color: #999;">
      Alert rule: "<%= @rule.name %>" &bull; Matching: category=<%= @rule.event_category.presence || "any" %>, severity=<%= @rule.severity.presence || "any" %>
    </p>
  </div>

  <div class="footer">
    Generated by vSphere Auditor &bull; <%= Time.current.strftime("%Y-%m-%d %H:%M %Z") %>
  </div>
</div>
