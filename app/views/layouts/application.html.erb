<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "vSphere Auditor" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="layout">
      <nav class="sidebar">
        <div class="sidebar-brand">vSphere Auditor</div>
        <ul class="sidebar-nav">
          <li><%= link_to "Dashboard", root_path, class: ("active" if controller_name == "dashboard") %></li>
          <li><%= link_to "Audit Events", audit_events_path, class: ("active" if controller_name == "audit_events") %></li>
        </ul>
      </nav>
      <main class="main-content">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
