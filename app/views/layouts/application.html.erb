<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "vSphere Auditor" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="layout">
      <nav class="sidebar">
        <div class="sidebar-brand">vSphere Auditor</div>
        <ul class="sidebar-nav">
          <li><%= link_to "Dashboard", root_path, class: ("active" if controller_name == "dashboard") %></li>
          <li><%= link_to "Audit Events", audit_events_path, class: ("active" if controller_name == "audit_events") %></li>
          <li><%= link_to "Alert Rules", alert_rules_path, class: ("active" if controller_name == "alert_rules") %></li>
          <li><%= link_to "vCenter Connections", vcenter_connections_path, class: ("active" if controller_name == "vcenter_connections") %></li>
          <li><%= link_to "System Status", system_status_path, class: ("active" if controller_name == "system_status") %></li>
        </ul>
        <% if logged_in? %>
          <div class="sidebar-footer">
            <span class="sidebar-user"><%= current_username %></span>
            <%= link_to "Sign Out", logout_path, data: { turbo_method: :delete }, class: "sidebar-logout" %>
          </div>
        <% end %>
      </nav>
      <main class="main-content">
        <% if notice %>
          <div class="notice"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="notice" style="background: #fdecea; border-color: #f5c6cb; color: var(--danger);"><%= alert %></div>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
